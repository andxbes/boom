{
  "name": "boom",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "boom-loudness": "file:./modules/boom-loudness",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "dotenv-cli": "^8.0.0",
    "eas-cli": "^16.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate:icons": "python3 scripts/generate-icons.py",
    "eas:login": "npx eas-cli login",
    "eas:init": "dotenv -e .env -- npx eas-cli init --non-interactive --force",
    "eas:credentials:android": "dotenv -e .env -- npx eas-cli credentials -p android",
    "build:apk": "dotenv -e .env -- npx eas-cli build --platform android --profile preview --wait",
    "build:apk:ci": "dotenv -e .env -- npx eas-cli build --platform android --profile preview --non-interactive --wait",
    "download:apk": "dotenv -e .env -- node ./scripts/download-apk.js",
    "build:android:prod": "dotenv -e .env -- npx eas-cli build --platform android --profile production --wait",
    "build:android:prod:ci": "dotenv -e .env -- npx eas-cli build --platform android --profile production --non-interactive --wait"
  },
  "private": true
}
